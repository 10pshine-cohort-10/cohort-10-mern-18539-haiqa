# Copy this file to .env (never commit .env).
# PowerShell:  Copy-Item .env.example .env

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# Local MongoDB (use 127.0.0.1 instead of localhost to avoid IPv6 issues on Windows)
MONGODB_URI=mongodb://127.0.0.1:27017/leafnote
# MongoDB Atlas example (replace <username>, <password> and the cluster address):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/leafnote?retryWrites=true&w=majority

# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
