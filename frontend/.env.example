# Copy this file to .env (never commit .env).
# PowerShell:  Copy-Item .env.example .env

# Base URL the React app uses for API calls.
# Keep "/api" in development: Vite forwards it to the backend (see vite.config.js).
VITE_API_URL=/api

# Where Vite forwards /api requests in development (your Express server).
VITE_PROXY_TARGET=http://localhost:5000
